
AFRAME.registerComponent('maze-game', {
  init: function () {
    const THREE = AFRAME.THREE;

    this.screen = document.querySelector('#tv-screen');
    this.gameScene = new THREE.Scene();
    this.gameScene.background = new THREE.Color(0x101820);

    this.gameCamera = new THREE.PerspectiveCamera(
      75, 16 / 9, 0.05, 100
    );
    this.gameCamera.rotation.order = 'YXZ';

    this.target = new THREE.WebGLRenderTarget(1024, 576);

    const gameScene = this.gameScene;
    const gameCamera = this.gameCamera;

    gameScene.add(
      new THREE.HemisphereLight(0xffffff, 0x555555, 2)
    );

    const light = new THREE.DirectionalLight(0xffffff, 1);
    light.position.set(5, 10, 5);
    gameScene.add(light);

    const size = 15;
    const cellSize = 2;
    const maze = [];
    const walls = [];

    const wallMaterial = new THREE.MeshStandardMaterial({
      color: 0x38b6a5,
      roughness: 0.8
    });

    const floorMaterial = new THREE.MeshStandardMaterial({
      color: 0x242d39
    });

    const wallGeometry = new THREE.BoxGeometry(
      cellSize, 2.5, cellSize
    );

    const floorGeometry = new THREE.PlaneGeometry(
      size * cellSize, size * cellSize
    );

    const floor = new THREE.Mesh(floorGeometry, floorMaterial);
    floor.rotation.x = -Math.PI / 2;
    floor.position.set(
      (size - 1) * cellSize / 2,
      0,
      (size - 1) * cellSize / 2
    );
    gameScene.add(floor);

    const generateMaze = () => {
      walls.forEach(wall => gameScene.remove(wall));
      walls.length = 0;

      for (let z = 0; z < size; z++) {
        maze[z] = [];
        for (let x = 0; x < size; x++) {
          maze[z][x] = 1;
        }
      }

      function carve(x, z) {
        maze[z][x] = 0;

        // Fisher-Yates shuffle
        const directions = [
          [0, -2], [0, 2], [-2, 0], [2, 0]
        ];

        for (let i = directions.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          [directions[i], directions[j]] =
            [directions[j], directions[i]];
        }

        for (const [dx, dz] of directions) {
          const nx = x + dx;
          const nz = z + dz;

          if (
            nx > 0 && nx < size - 1 &&
            nz > 0 && nz < size - 1 &&
            maze[nz][nx] === 1
          ) {
            maze[z + dz / 2][x + dx / 2] = 0;
            carve(nx, nz);
          }
        }
      }

      carve(1, 1);

      for (let z = 0; z < size; z++) {
        for (let x = 0; x < size; x++) {
          if (maze[z][x] === 1) {
            const wall = new THREE.Mesh(
              wallGeometry, wallMaterial
            );

            wall.position.set(
              x * cellSize,
              1.25,
              z * cellSize
            );

            gameScene.add(wall);
            walls.push(wall);
          }
        }
      }

      gameCamera.position.set(cellSize, 1, cellSize);
      gameCamera.rotation.set(0, 0, 0);
    };

    this.generateMaze = generateMaze;
    this.canMove = (x, z) => {
      const radius = 0.2;

      for (const dx of [-radius, radius]) {
        for (const dz of [-radius, radius]) {
          const gx = Math.round((x + dx) / cellSize);
          const gz = Math.round((z + dz) / cellSize);

          if (
            gx < 0 || gx >= size ||
            gz < 0 || gz >= size ||
            maze[gz][gx] === 1
          ) return false;
        }
      }
      return true;
    };

    generateMaze();

    this.keys = {};

    this.onKeyDown = (e) => {
      if ([
        'ArrowUp', 'ArrowDown',
        'ArrowLeft', 'ArrowRight'
      ].includes(e.code)) {
        e.preventDefault();
        this.keys[e.code] = true;
      }

      if (e.code === 'KeyR' && !e.repeat) {
        generateMaze();
      }
    };

    this.onKeyUp = (e) => {
      this.keys[e.code] = false;
    };

    this.onBlur = () => {
      this.keys = {};
    };

    window.addEventListener('keydown', this.onKeyDown);
    window.addEventListener('keyup', this.onKeyUp);
    window.addEventListener('blur', this.onBlur);

    this.screenMaterial = new THREE.MeshBasicMaterial({
      map: this.target.texture,
      side: THREE.DoubleSide,
      toneMapped: false
    });

    this.attachScreen = () => {
      const mesh = this.screen.getObject3D('mesh');
      if (!mesh) return;

      this.originalMaterial = mesh.material;
      mesh.material = this.screenMaterial;
      this.screenMesh = mesh;
    };

    this.attachScreen();
    this.screen.addEventListener(
      'object3dset', this.attachScreen
    );

    this.wallGeometry = wallGeometry;
    this.wallMaterial = wallMaterial;
    this.floorGeometry = floorGeometry;
    this.floorMaterial = floorMaterial;
  },

  tick: function (time, delta) {
    const dt = Math.min(delta / 1000, 0.05);
    const keys = this.keys;
    const camera = this.gameCamera;

    const turnSpeed = 1.8;
    const moveSpeed = 3;

    if (keys.ArrowLeft) {
      camera.rotation.y += turnSpeed * dt;
    }

    if (keys.ArrowRight) {
      camera.rotation.y -= turnSpeed * dt;
    }

    let movement = 0;

    if (keys.ArrowUp) movement = -moveSpeed * dt;
    if (keys.ArrowDown) movement = moveSpeed * dt;

    const angle = camera.rotation.y;

    const nx = camera.position.x +
      Math.sin(angle) * movement;

    const nz = camera.position.z +
      Math.cos(angle) * movement;

    if (this.canMove(nx, camera.position.z)) {
      camera.position.x = nx;
    }

    if (this.canMove(camera.position.x, nz)) {
      camera.position.z = nz;
    }
  },

  tock: function () {
    const renderer = this.el.renderer;
    if (!renderer) return;

    const width = this.screen.getAttribute('width');
    const height = this.screen.getAttribute('height');

    if (width > 0 && height > 0) {
      const aspect = width / height;
      if (this.gameCamera.aspect !== aspect) {
        this.gameCamera.aspect = aspect;
        this.gameCamera.updateProjectionMatrix();
      }
    }

    const previousTarget = renderer.getRenderTarget();
    const previousXr = renderer.xr.enabled;
    const previousShadow = renderer.shadowMap.autoUpdate;

    renderer.xr.enabled = false;
    renderer.shadowMap.autoUpdate = false;

    renderer.setRenderTarget(this.target);
    renderer.render(this.gameScene, this.gameCamera);
    renderer.setRenderTarget(previousTarget);

    renderer.xr.enabled = previousXr;
    renderer.shadowMap.autoUpdate = previousShadow;
  },

  remove: function () {
    window.removeEventListener('keydown', this.onKeyDown);
    window.removeEventListener('keyup', this.onKeyUp);
    window.removeEventListener('blur', this.onBlur);

    this.screen.removeEventListener(
      'object3dset', this.attachScreen
    );

    if (this.screenMesh) {
      this.screenMesh.material = this.originalMaterial;
    }

    this.gameScene.traverse(obj => {
      // Shared wall and floor resources are disposed below.
      if (obj.isMesh && obj.geometry !== this.wallGeometry &&
          obj.geometry !== this.floorGeometry) {
        obj.geometry.dispose();
      }
    });

    this.wallGeometry.dispose();
    this.wallMaterial.dispose();
    this.floorGeometry.dispose();
    this.floorMaterial.dispose();
    this.screenMaterial.dispose();
    this.target.dispose();
  }
});


AFRAME.registerComponent('tv-screen-adjust', {
  init: function () {
    this.onKeyDown = (event) => {
      // Hold Shift to adjust the screen.
      // Normal arrow keys are reserved for the maze.
      if (!event.shiftKey) return;

      const screen = this.el;
      const pos = screen.getAttribute('position');
      let width = screen.getAttribute('width');
      let height = screen.getAttribute('height');
      const step = 0.01;

      switch (event.code) {
        case 'KeyA': pos.x -= step; break;
        case 'KeyD': pos.x += step; break;
        case 'KeyW': pos.y += step; break;
        case 'KeyS': pos.y -= step; break;
        case 'KeyQ': pos.z -= step; break;
        case 'KeyE': pos.z += step; break;

        case 'KeyJ': width -= step; break;
        case 'KeyL': width += step; break;
        case 'KeyI': height += step; break;
        case 'KeyK': height -= step; break;

        default: return;
      }

      event.preventDefault();

      screen.setAttribute('position', pos);
      screen.setAttribute('width', Math.max(0.01, width));
      screen.setAttribute('height', Math.max(0.01, height));

      console.log(
        'Screen position:', pos,
        'Width:', width,
        'Height:', height
      );
    };

    window.addEventListener('keydown', this.onKeyDown);
  },

  remove: function () {
    window.removeEventListener('keydown', this.onKeyDown);
  }
});
